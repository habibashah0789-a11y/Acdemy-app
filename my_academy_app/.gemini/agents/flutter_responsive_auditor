============================================================
RESPONSIVE UTILITY TEMPLATE
============================================================

When creating lib/utils/responsive_utils.dart, use this template:

```dart
import 'package:flutter/material.dart';

/// Centralized responsive breakpoints and utilities.
/// These are logical-pixel width thresholds, not device-specific values.
class AppBreakpoints {
  AppBreakpoints._();

  static const double compact = 600;
  static const double medium = 1024;

  static bool isCompact(BuildContext context) =>
      MediaQuery.sizeOf(context).width < compact;

  static bool isMedium(BuildContext context) {
    final w = MediaQuery.sizeOf(context).width;
    return w >= compact && w < medium;
  }

  static bool isExpanded(BuildContext context) =>
      MediaQuery.sizeOf(context).width >= medium;

  /// Returns a value based on current breakpoint.
  static T value<T>(
    BuildContext context, {
    required T compact,
    T? medium,
    required T expanded,
  }) {
    final w = MediaQuery.sizeOf(context).width;
    if (w < AppBreakpoints.compact) return compact;
    if (w < AppBreakpoints.medium) return medium ?? expanded;
    return expanded;
  }

  /// Responsive page padding.
  static EdgeInsets pagePadding(BuildContext context) => value(
        context,
        compact: const EdgeInsets.all(14),
        medium: const EdgeInsets.all(20),
        expanded: const EdgeInsets.all(24),
      );

  /// Responsive grid column count based on available width.
  static int gridColumns(double availableWidth, {double minItemWidth = 160}) =>
      (availableWidth / minItemWidth).floor().clamp(1, 6);
}

/// A widget that builds different layouts based on available width.
/// Uses LayoutBuilder for component-level responsiveness.
class ResponsiveLayout extends StatelessWidget {
  final Widget compact;
  final Widget? medium;
  final Widget expanded;

  const ResponsiveLayout({
    super.key,
    required this.compact,
    this.medium,
    required this.expanded,
  });

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        if (constraints.maxWidth < AppBreakpoints.compact) return compact;
        if (constraints.maxWidth < AppBreakpoints.medium) {
          return medium ?? expanded;
        }
        return expanded;
      },
    );
  }
}

/// Extension on BuildContext for quick responsive checks.
extension ResponsiveContext on BuildContext {
  bool get isCompact => AppBreakpoints.isCompact(this);
  bool get isMedium => AppBreakpoints.isMedium(this);
  bool get isExpanded => AppBreakpoints.isExpanded(this);

  EdgeInsets get responsivePadding => AppBreakpoints.pagePadding(this);

  T responsiveValue<T>({
    required T compact,
    T? medium,
    required T expanded,
  }) =>
      AppBreakpoints.value(this, compact: compact, medium: medium, expanded: expanded);
}
```

============================================================
COMMON FIX PATTERNS
============================================================

PATTERN: Row with text overflow
BEFORE:
    Row(children: [Icon(...), Text(longString)])
AFTER:
    Row(children: [Icon(...), SizedBox(width: 8),
      Expanded(child: Text(longString, overflow: TextOverflow.ellipsis))])

PATTERN: Fixed-width container
BEFORE:
    Container(width: 700, child: content)
AFTER:
    ConstrainedBox(
      constraints: BoxConstraints(maxWidth: 700),
      child: Container(width: double.infinity, child: content))

PATTERN: Side-by-side cards (non-responsive)
BEFORE:
    Row(children: [Expanded(child: CardA()), SizedBox(width: 16), Expanded(child: CardB())])
AFTER:
    LayoutBuilder(builder: (ctx, c) {
      if (c.maxWidth < 500)
        return Column(children: [CardA(), SizedBox(height: 12), CardB()]);
      return Row(children: [Expanded(child: CardA()), SizedBox(width: 16), Expanded(child: CardB())]);
    })

PATTERN: Desktop dialog too wide on mobile
BEFORE:
    Dialog(child: Container(width: 800, ...))
AFTER:
    Dialog(child: ConstrainedBox(
      constraints: BoxConstraints(maxWidth: min(800, MediaQuery.sizeOf(context).width - 32)),
      child: ...))

PATTERN: Form without scroll
BEFORE:
    Column(children: [TextField(), TextField(), TextField(), Button()])
AFTER:
    SingleChildScrollView(child: Column(children: [...]))

PATTERN: Grid with fixed columns
BEFORE:
    GridView.count(crossAxisCount: 4, children: [...])
AFTER:
    LayoutBuilder(builder: (ctx, c) {
      final cols = (c.maxWidth / 180).floor().clamp(1, 4);
      return GridView.count(crossAxisCount: cols, children: [...]);
    })

PATTERN: Table not fitting mobile
BEFORE:
    DataTable(columns: [8 columns], rows: [...])
AFTER:
    SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: DataTable(columns: [8 columns], rows: [...]))
  OR (card transformation for mobile):
    LayoutBuilder(builder: (ctx, c) {
      if (c.maxWidth < 600) return _buildMobileCardList(data);
      return DataTable(...);
    })

PATTERN: Buttons overflowing in Row
BEFORE:
    Row(children: [ElevatedButton('Cancel'), ElevatedButton('Save'), ElevatedButton('Save & Add')])
AFTER:
    Wrap(spacing: 8, runSpacing: 8, children: [...buttons])

PATTERN: Excessive padding on mobile
BEFORE:
    Padding(padding: EdgeInsets.all(32), child: content)
AFTER:
    Padding(padding: context.responsivePadding, child: content)

