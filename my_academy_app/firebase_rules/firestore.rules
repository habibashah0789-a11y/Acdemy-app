rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isTeacher() {
      return isSignedIn();
    }

    // Roles
    match /roles/{uid} {
      allow read, write: if true;
    }

    // Teachers
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // Teacher Payouts
    match /teacher_payouts/{payoutId} {
      allow read, write: if true;
    }

    // Students
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Student Auth
    match /student_auth/{studentId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Everything else
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
