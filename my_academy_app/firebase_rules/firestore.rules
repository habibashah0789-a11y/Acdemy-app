rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/roles/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher') ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
      );
    }

    function isStudent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'student';
    }

    // Helper to verify a teacher is creating an announcement ONLY for their authorized subject
    function isTeacherForSubject() {
      return isTeacher() &&
             exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
             (
               request.resource.data.teacherSubject == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.subject ||
               request.resource.data.targetSubject == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.subject ||
               request.resource.data.subject == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.subject
             ) &&
             (
               request.resource.data.senderId == request.auth.uid ||
               request.resource.data.teacherId == request.auth.uid ||
               request.resource.data.registeredBy != null
             );
    }

    // ── Roles ───────────────────────────────────────────────────────
    match /roles/{uid} {
      allow read, write: if true;
    }

    // ── Teachers ────────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ── Teacher Payouts & Salary Ledger ──────────────────────────────
    match /teacher_payouts/{payoutId} {
      allow read, get, list, create, update, delete, write: if true;
    }

    // ── Students ────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isAdmin() || isTeacher();
      }
    }

    // ── Student Auth ─────────────────────────────────────────────────
    match /student_auth/{studentId} {
      allow read, write: if true;
    }

    // ── Notifications, Announcements & Notices ──────────────────────
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if isAdmin() || isTeacherForSubject();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.senderId == request.auth.uid);
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin() || isTeacherForSubject();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.senderId == request.auth.uid);
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isAdmin() || isTeacherForSubject();
      allow update, delete: if isAdmin();
    }

    match /teacher_announcements/{announcementId} {
      allow read: if true;
      allow create: if isAdmin() || isTeacherForSubject();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.senderId == request.auth.uid);
    }

    // ── Devices (FCM Push Tokens) ────────────────────────────────────
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // ── Notification Triggers (Cloud Functions) ─────────────────────
    match /notification_triggers/{triggerId} {
      allow read, write: if true;
    }

    // ── Recycled Students ────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if true;
    }

    // ── Payment Transactions & Financial Ledger ─────────────────────
    match /payment_transactions/{txnId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /payment_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /fee_records/{feeRecordId} {
      allow read, write: if true;
    }

    // ── Academy Profile & Schedules ──────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if true;
    }

    match /class_schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /daily_records/{recordId} {
      allow read, write: if true;
    }

    // ── Admins ───────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // ── Fallback ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
  }
}
