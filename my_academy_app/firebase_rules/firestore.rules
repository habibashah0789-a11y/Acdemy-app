rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isTeacher() {
      return isSignedIn();
    }

    function isStudent() {
      return isSignedIn();
    }

    // ── Roles ───────────────────────────────────────────────────────
    match /roles/{uid} {
      allow read, write: if true;
    }

    // ── Teachers ────────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ── Teacher Payouts & Salary Ledger ──────────────────────────────
    match /teacher_payouts/{payoutId} {
      allow read, get, list, create, update, delete, write: if true;
    }

    // ── Students ────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ── Student Auth ─────────────────────────────────────────────────
    match /student_auth/{studentId} {
      allow read, write: if true;
    }

    // ── Notifications, Announcements & Notices ──────────────────────
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /notices/{noticeId} {
      allow read, write: if true;
    }

    match /teacher_announcements/{announcementId} {
      allow read, write: if true;
    }

    match /teacher_notices/{noticeId} {
      allow read, write: if true;
    }

    // ── Devices (FCM Push Tokens) ────────────────────────────────────
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // ── Notification Triggers (Cloud Functions) ─────────────────────
    match /notification_triggers/{triggerId} {
      allow read, write: if true;
    }

    // ── Recycled Students ────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if true;
    }

    // ── Payment Transactions & Financial Ledger ─────────────────────
    match /payment_transactions/{txnId} {
      allow read, write: if true;
    }

    match /payment_config/{configId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /fee_records/{feeRecordId} {
      allow read, write: if true;
    }

    // ── Academy Profile & Schedules ──────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if true;
    }

    match /class_schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /daily_records/{recordId} {
      allow read, write: if true;
    }

    // ── Admins ───────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // ── Fallback ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
