rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    // Students: public read for student portal (Firestore-only auth)
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Student Auth: public read for QR login flow & device binding updates
    match /student_auth/{studentId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedDeviceId', 'deviceLinkedAt', 'accountStatus', 'studentId', 'studentCode'])
      );
    }

    // Notifications: public read so students can see announcements
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Everything else: admin-only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
