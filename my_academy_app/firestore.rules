rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher';
    }

    // ── Roles ───────────────────────────────────────────────────────
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ── Teachers ────────────────────────────────────────────────────
    // Admin can read/write all. A teacher can read/update their own doc.
    match /teachers/{teacherId} {
      allow read: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
    }

    // ── Students ────────────────────────────────────────────────────
    // Public read (student portal has no Firebase Auth).
    // Teachers also read students; client-side filtering scopes to their subject.
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Student Auth ─────────────────────────────────────────────────
    match /student_auth/{studentId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['linkedDeviceId', 'deviceLinkedAt', 'accountStatus', 'studentId', 'studentCode'])
      );
    }

    // ── Notifications / Announcements ────────────────────────────────
    // Public read; admins and teachers can create, update, delete announcements.
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isTeacher();
    }

    // ── Devices (FCM Push Tokens) ────────────────────────────────────
    match /devices/{deviceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Notification Triggers (Cloud Functions) ─────────────────────
    match /notification_triggers/{triggerId} {
      allow read, create: if isAdmin() || isTeacher();
    }

    // ── Recycled Students ────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if isAdmin();
    }

    // ── Academy Profile ──────────────────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if isAdmin();
    }
  }
}