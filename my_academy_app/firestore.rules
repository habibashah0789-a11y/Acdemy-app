rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/roles/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
      );
    }
    

    function isTeacher() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher';
    }

    // ── Roles ───────────────────────────────────────────────────────
    match /roles/{uid} {
      allow read, write: if true;
    }

    // ── Teachers ────────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ── Teacher Payouts & Salary Ledger ──────────────────────────────
    match /teacher_payouts/{payoutId} {
      allow read, get, list, create, update, delete, write: if true;
    }

    // ── Students ────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ── Student Auth ─────────────────────────────────────────────────
    match /student_auth/{studentId} {
      allow read, write: if true;
    }

    // ── Notifications / Announcements ────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdmin() || isTeacher() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        (
          resource.data.userId == request.auth.uid ||
          (resource.data.type == 'teacher_announcement' && (
            (exists(resource.data.targetClass) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.class == resource.data.targetClass) ||
            (exists(resource.data.targetSubject) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.subject.matches('.*' + resource.data.targetSubject + '.*'))
          )) ||
          !exists(resource.data.type) ||
          (resource.data.type != 'teacher_announcement' && !exists(resource.data.userId))
        )
      );
      allow write: if isAdmin() || isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || isTeacher() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        (
          resource.data.userId == request.auth.uid ||
          (resource.data.type == 'teacher_announcement' && (
            (exists(resource.data.targetClass) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.class == resource.data.targetClass) ||
            (exists(resource.data.targetSubject) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.subject.matches('.*' + resource.data.targetSubject + '.*'))
          )) ||
          !exists(resource.data.type) ||
          (resource.data.type != 'teacher_announcement' && !exists(resource.data.userId))
        )
      );
      allow write: if isAdmin() || isTeacher();
    }

    // ── Devices (FCM Push Tokens) ────────────────────────────────────
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // ── Notification Triggers (Cloud Functions) ─────────────────────
    match /notification_triggers/{triggerId} {
      allow read, write: if true;
    }

    // ── Recycled Students ────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if true;
    }

    // ── Payment Transactions & Financial Ledger ─────────────────────
    match /payment_transactions/{txnId} {
      allow read, write: if true;
    }

    match /payment_config/{configId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /fee_records/{feeRecordId} {
      allow read, write: if true;
    }

    // ── Academy Profile & Schedules ──────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if true;
    }

    match /class_schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /daily_records/{recordId} {
      allow read, write: if true;
    }

    // ── Fallback ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}