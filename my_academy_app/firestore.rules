    }

    // ── Devices (FCM Push Tokens) ─────────────────────────────────────────
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // ── Notification Triggers (Cloud Functions & FCM Push) ────────────────
    match /notification_triggers/{triggerId} {
      allow read, write, create: if true;
    }

    // ── Recycled Students ─────────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if true;
    }

    // ── Payment Transactions & Financial Ledger ───────────────────────────
    match /payment_transactions/{txnId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /payment_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /fee_records/{feeRecordId} {
      allow read, write: if true;
    }

    // ── Academy Profile & Schedules ───────────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if true;
    }

    match /class_schedules/{scheduleId} {
      allow read, write: if true;
    }

    match /daily_records/{recordId} {
      allow read, write: if true;
    }

    // ── Admins ────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // ── Fallback ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }
  }
