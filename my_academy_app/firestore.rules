    // ── Roles ─────────────────────────────────────────────────────────────
    match /roles/{uid} {
      allow read, write: if true;
    }

    // ── Teachers ──────────────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // ── Teacher Payouts & Salary Ledger ───────────────────────────────────
    match /teacher_payouts/{payoutId} {
      allow read, get, list, create, update, delete, write: if true;
    }

    // ── Students ──────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

