rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$,(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    function isStudent() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'student';
    }

    function isStudentOwner(studentId) {
      return isStudent() &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.studentId == studentId;
    }

    // ── Roles ──────────────────────────────────────────────────────
    match /roles/{uid} {
      // Any authenticated user can read their own role document
      allow read, create: if isSignedIn() && request.auth.uid == uid;

      // Only admins can update/delete role documents
      allow update, delete: if isAdmin();
    }

    // ── Students ───────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isAdmin() || isStudentOwner(studentId);
      allow create, update, delete: if isAdmin();
    }

    // ── Student Auth ───────────────────────────────────────────────
    match /student_auth/{studentId} {
      allow read: if isAdmin() || isStudentOwner(studentId);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isStudentOwner(studentId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['linkedDeviceId', 'deviceLinkedAt']) &&
         resource.data.linkedDeviceId == '');
    }

    // ── Notifications ──────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isStudent() && (resource.data.studentId == '' || resource.data.studentId == 'all' || resource.data.studentId == get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.studentId));
      allow create, update, delete: if isAdmin();
    }

    // ── Recycled Students ──────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if isAdmin();
    }

    // ── Academy Profile ────────────────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if isAdmin();
    }
  }
}