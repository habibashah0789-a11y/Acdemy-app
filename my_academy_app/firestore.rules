rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/roles/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isTeacher() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher';
    }

    // ── Roles ───────────────────────────────────────────────────────
    // Allow read & write so admin can seamlessly create & manage teacher roles
    match /roles/{uid} {
      allow read, write: if true;
    }

    // ── Teachers ────────────────────────────────────────────────────
    // Public read & write for creating, updating, and managing teacher records
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // ── Teacher Payouts ──────────────────────────────────────────────
    // Public read & write for recording payouts and teacher payout ledger
    match /teacher_payouts/{payoutId} {
      allow read, write: if true;
    }

    // ── Students ────────────────────────────────────────────────────
    // Public read & write for student portal and admin management
    match /students/{studentId} {
      allow read, write: if true;
    }

    // ── Student Auth ─────────────────────────────────────────────────
    match /student_auth/{studentId} {
      allow read, write: if true;
    }

    // ── Notifications / Announcements ────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // ── Devices (FCM Push Tokens) ────────────────────────────────────
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // ── Notification Triggers (Cloud Functions) ─────────────────────
    match /notification_triggers/{triggerId} {
      allow read, write: if true;
    }

    // ── Recycled Students ────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if true;
    }

    // ── Academy Profile ──────────────────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if true;
    }

    // ── Fallback ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}