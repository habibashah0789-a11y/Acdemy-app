rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: authenticated user accesses own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Students collection: authenticated users only
    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }
    
    // Recycled students collection: authenticated users only
    match /recycled_students/{recycledId} {
      allow read, write: if request.auth != null;
    }
    
    // Notifications collection: authenticated users only
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    
    // Academy profile collection: authenticated users only
    match /academy_profile/{profileId} {
      allow read, write: if request.auth != null;
    }
    
    // Teachers collection: authenticated users only
    match /teachers/{teacherId} {
      allow read, write: if request.auth != null;
    }
    
    // Catch-all rule for all other documents: authenticated users only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}