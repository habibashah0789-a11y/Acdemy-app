rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin helper ────────────────────────────────────────────────
    // Only Firebase-authenticated admins may write data.
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Roles ───────────────────────────────────────────────────────
    // Admin-only: role documents are never read by student portal.
    match /roles/{uid} {
      allow read, create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    // ── Students ────────────────────────────────────────────────────
    // Public read: student portal uses Firestore-only login (no Firebase Auth).
    // All writes remain admin-only.
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Student Auth ─────────────────────────────────────────────────
    // Public read: used during QR-code login to verify the token hash.
    // The QR token is stored as a SHA-256 hash, so exposure is safe.
    // All writes remain admin-only.
    match /student_auth/{studentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Notifications / Announcements ────────────────────────────────
    // Public read: student portal displays admin-created announcements.
    // Client-side filtering handles per-student vs. broadcast notices.
    // All writes remain admin-only.
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Recycled Students ────────────────────────────────────────────
    match /recycled_students/{studentId} {
      allow read, write: if isAdmin();
    }

    // ── Academy Profile ──────────────────────────────────────────────
    match /academy_profile/{uid} {
      allow read, write: if isAdmin();
    }
  }
}